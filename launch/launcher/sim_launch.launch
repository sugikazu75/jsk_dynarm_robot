<?xml version="1.0"?>
<launch>
  ###########  launch config  ###########
  <arg name="headless" default="True" />
  <arg name="version" default="v1"/>
  <arg name="root_fix" default="True"/>

  <arg name="robot_ns" value="dynarm" />
  <arg name="spawn_x" default="0.0"/>
  <arg name="spawn_y" default="0.0"/>
  <arg name="spawn_z" default="1.5"/>
  <arg name="spawn_yaw" default="0.0"/>
  <arg name="sim_estimate_mode"  default= "2" />

  ###########  UAV Config  ###########
  <group ns="$(arg robot_ns)">

    ###########  Basic Param  ###########
    <param name="estimation/mode" value= "$(arg sim_estimate_mode)" />

  </group>

  ###########  Robot Model  ###########
  <arg name="description_mode" value="gazebo"/>
  <include file="$(find aerial_robot_model)/launch/aerial_robot_model.launch" >
    <arg name="headless" value="$(arg headless)" />
    <arg name="robot_model" value="$(find dynarm)/robots/$(arg version)/dynarm.$(arg description_mode).xacro"/>
    <arg name="robot_ns" value="$(arg robot_ns)" />
    <arg name="rviz_config" value="$(find dynarm)/config/$(arg version)/rviz_config" />
    <arg name="rviz_init_pose" value="$(find dynarm)/config/$(arg version)/RvizInit.yaml" />
    <arg name="need_joint_state" value="false"/>
  </include >

  ########### Fix root link to world ###########
  <node pkg="dynarm" type="root_fix.py" name="root_fix_node">
    <param name="root_fix" value="$(arg root_fix)"/>
  </node>

  ########## Simulation in Gazebo #########
  <include file="$(find aerial_robot_simulation)/launch/gazebo.launch" >
    <arg name="robot_ns" default="$(arg robot_ns)" />
    <arg name="gui" default="false" if="$(arg headless)" />
    <arg name="headless" default="$(arg headless)" />
    <arg name="spawn_x" value="$(arg spawn_x)" />
    <arg name="spawn_y" value="$(arg spawn_y)" />
    <arg name="spawn_z" value="$(arg spawn_z)" />
    <arg name="spawn_yaw" value="$(arg spawn_yaw)" />
  </include>

</launch>
